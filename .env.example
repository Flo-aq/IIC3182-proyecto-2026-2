# Copia este archivo a .env.local y completa los valores (Supabase: Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...): puede ir en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...): solo en el servidor, nunca en el repo.
SUPABASE_SECRET_KEY=

# Clave de los cron (cualquier texto largo y secreto). En Vercel, Vercel la envía sola; el workflow de GitHub usa el mismo valor.
CRON_SECRET=

# Correos de los avisos (Resend: resend.com > API Keys). Sin esta clave, en desarrollo los correos se muestran en la consola.
RESEND_API_KEY=
# Remitente: "WeMeet <avisos@tu-dominio.cl>" (el dominio debe estar verificado en Resend). Sin dominio solo sirve
# "WeMeet <onboarding@resend.dev>" y únicamente entrega al correo de tu cuenta de Resend.
EMAIL_FROM=
